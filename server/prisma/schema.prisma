generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum MentorRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ThesisStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROGRESS
  SUBMITTED
  UNDER_EVALUATION
  COMPLETED
}

enum ThesisVersionStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  APPROVED
}

enum CommitteeStatus {
  ASSIGNED
  SCHEDULED
  COMPLETED
}

enum CommitteeMemberRole {
  CHAIR
  MEMBER
}

// ======================================================
// ROLES
// ======================================================

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  users       User[]
  permissions RolePermission[]
}

// ======================================================
// PERMISSIONS
// ======================================================

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

// ======================================================
// ROLE PERMISSIONS
// ======================================================

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ======================================================
// STUDY PROGRAMS
// ======================================================

model StudyProgram {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  department  String?  @db.VarChar(150)
  degreeLevel String?  @db.VarChar(50)
  status      String   @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime @default(now())

  users User[]
}

// ======================================================
// USERS
// ======================================================

model User {
  id             Int      @id @default(autoincrement())
  roleId         Int
  studyProgramId Int?
  firstName      String   @db.VarChar(100)
  lastName       String   @db.VarChar(100)
  email          String   @unique @db.VarChar(150)
  passwordHash   String   @db.VarChar(255)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  role         Role          @relation(fields: [roleId], references: [id])
  studyProgram StudyProgram? @relation(fields: [studyProgramId], references: [id])

  studentProfile         StudentProfile?
  mentorProfile          MentorProfile?
  committeeMemberProfile CommitteeMemberProfile?

  studentMentorRequests MentorRequest[] @relation("StudentMentorRequests")

  studentTheses Thesis[] @relation("StudentTheses")
  mentorTheses  Thesis[] @relation("MentorTheses")

  uploadedVersions ThesisVersion[] @relation("UploadedVersions")

  feedback Feedback[] @relation("MentorFeedback")
}

// ======================================================
// STUDENT PROFILES
// ======================================================

model StudentProfile {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  studentNumber      String   @unique @db.VarChar(50)
  studyYear          Int?
  earnedCredits      Decimal? @db.Decimal(5, 2)
  verificationStatus String?  @db.VarChar(30)
  phone              String?  @db.VarChar(30)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ======================================================
// MENTOR PROFILES
// ======================================================

model MentorProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  academicTitle  String?  @db.VarChar(100)
  specialization String?  @db.Text
  department     String?  @db.VarChar(150)
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  mentorRequests MentorRequest[] @relation("MentorProfileRequests")
}

// ======================================================
// COMMITTEE MEMBER PROFILES
// ======================================================

model CommitteeMemberProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  academicTitle  String?  @db.VarChar(100)
  specialization String?  @db.Text
  department     String?  @db.VarChar(150)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  committeeMemberships CommitteeMember[]
  evaluations          Evaluation[]
}

// ======================================================
// MENTOR REQUESTS
// ======================================================

model MentorRequest {
  id           Int                 @id @default(autoincrement())
  studentId    Int
  mentorId     Int
  status       MentorRequestStatus @default(PENDING)
  message      String?             @db.Text
  requestDate  DateTime            @default(now())
  responseDate DateTime?

  student User @relation("StudentMentorRequests", fields: [studentId], references: [id], onDelete: Cascade)

  mentor MentorProfile @relation("MentorProfileRequests", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([mentorId])
}

// ======================================================
// THESES
// ======================================================

model Thesis {
  id            Int          @id @default(autoincrement())
  studentId     Int
  mentorId      Int
  title         String       @db.VarChar(255)
  description   String?      @db.Text
  researchField String?      @db.VarChar(150)
  status        ThesisStatus @default(PENDING)
  startedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  student User @relation("StudentTheses", fields: [studentId], references: [id], onDelete: Cascade)

  mentor User @relation("MentorTheses", fields: [mentorId], references: [id])

  versions    ThesisVersion[]
  committee   Committee?
  evaluations Evaluation[]

  @@index([studentId])
  @@index([mentorId])
}

// ======================================================
// THESIS VERSIONS
// ======================================================

model ThesisVersion {
  id            Int                 @id @default(autoincrement())
  thesisId      Int
  versionNumber Int
  fileName      String              @db.VarChar(255)
  filePath      String              @db.VarChar(500)
  uploadedBy    Int
  status        ThesisVersionStatus @default(DRAFT)
  isCurrent     Boolean             @default(false)
  uploadedAt    DateTime            @default(now())

  thesis Thesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)

  uploader User @relation("UploadedVersions", fields: [uploadedBy], references: [id])

  feedback Feedback[]

  @@unique([thesisId, versionNumber])
  @@index([thesisId])
  @@index([uploadedBy])
}

// ======================================================
// FEEDBACK
// ======================================================

model Feedback {
  id        Int      @id @default(autoincrement())
  versionId Int
  mentorId  Int
  comment   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  version ThesisVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  mentor User @relation("MentorFeedback", fields: [mentorId], references: [id])

  @@index([versionId])
  @@index([mentorId])
}

// ======================================================
// COMMITTEES
// ======================================================

model Committee {
  id           Int             @id @default(autoincrement())
  thesisId     Int             @unique
  assignedDate DateTime        @default(now())
  defenseDate  DateTime?
  status       CommitteeStatus @default(ASSIGNED)
  createdAt    DateTime        @default(now())

  thesis  Thesis            @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  members CommitteeMember[]
}

// ======================================================
// COMMITTEE MEMBERS
// ======================================================

model CommitteeMember {
  id                Int                 @id @default(autoincrement())
  committeeId       Int
  committeeMemberId Int
  role              CommitteeMemberRole
  assignedAt        DateTime            @default(now())

  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  member CommitteeMemberProfile @relation(fields: [committeeMemberId], references: [id], onDelete: Cascade)

  @@unique([committeeId, committeeMemberId])
  @@index([committeeId])
  @@index([committeeMemberId])
}

// ======================================================
// EVALUATIONS
// ======================================================

model Evaluation {
  id                Int      @id @default(autoincrement())
  thesisId          Int
  committeeMemberId Int
  grade             Decimal  @db.Decimal(4, 2)
  comments          String?  @db.Text
  evaluationDate    DateTime @default(now())

  thesis Thesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)

  committeeMember CommitteeMemberProfile @relation(fields: [committeeMemberId], references: [id])

  @@unique([thesisId, committeeMemberId])
  @@index([thesisId])
  @@index([committeeMemberId])
}
